{
  "name": "@jrumandal/catalog-svc",
  "version": "0.0.1",
  "private": true,
  "description": "Catalog domain microservice (NestJS + GraphQL + Prisma).",
  "type": "commonjs",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^10.3.0",
    "@jrumandal/shared": "workspace:*",
    "graphql": "^16.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "9.39.5",
    "jest": "~30.3.0",
    "ts-jest": "^29.4.7",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.35.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0"
}
